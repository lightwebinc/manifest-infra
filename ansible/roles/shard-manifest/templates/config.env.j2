{# shard-manifest environment configuration
   Managed by Ansible — do not edit manually.
#}
SHARD_BITS={{ shard_bits }}
JOINED_GROUPS={{ joined_groups }}
BITMAP={{ manifest_encoding }}
ROLE_HINT={{ role_hint }}
GENERATION_ID={{ generation_id }}
AUTHORITATIVE={{ 'true' if authoritative else 'false' }}
PILOT_ONLY={{ 'true' if manifest_pilot_only else 'false' }}
INSTANCE_ID={{ instance_id }}
IFACE={{ iface }}
PORT={{ manifest_port }}
MANIFEST_SCOPE={{ manifest_scope }}
MC_GROUP_ID={{ mc_group_id }}
ANNOUNCE_INTERVAL={{ announce_interval }}
TTL={{ ttl }}
SOURCE_MODE={{ manifest_source_mode }}
PUBLISHERS={{ manifest_publishers }}
PUBLISHERS_REFRESH={{ manifest_publishers_refresh }}
{% if manifest_successor_generation_id %}
SUCCESSOR_GENERATION_ID={{ manifest_successor_generation_id }}
SUCCESSOR_SHARD_BITS={{ manifest_successor_shard_bits }}
SUCCESSOR_SOURCE_MODE={{ manifest_successor_source_mode }}
SUCCESSOR_TRANSITION_EPOCH={{ manifest_successor_transition_epoch }}
{% endif %}
METRICS_ADDR={{ metrics_addr }}
OTLP_ENDPOINT={{ otlp_endpoint }}
OTLP_INTERVAL={{ otlp_interval }}
LOG_FORMAT={{ log_format }}
LOG_LEVEL={{ log_level }}
TRACE_SAMPLING={{ trace_sampling }}
DEBUG={{ 'true' if manifest_debug else 'false' }}
