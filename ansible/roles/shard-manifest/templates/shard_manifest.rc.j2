#!/bin/sh
#
# PROVIDE: shard_manifest
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# Managed by Ansible — do not edit manually
#
# Add the following to /etc/rc.conf to enable:
#   shard_manifest_enable="YES"

. /etc/rc.subr

name="shard_manifest"
rcvar="shard_manifest_enable"
desc="Bitcoin Shard Manifest Announcement Daemon"

load_rc_config "${name}"

: ${shard_manifest_enable:="NO"}
: ${shard_manifest_user:="{{ manifest_user }}"}
: ${shard_manifest_group:="{{ manifest_group }}"}
: ${shard_manifest_config:="/usr/local/etc/shard-manifest.conf"}
: ${shard_manifest_logfile:="/var/log/shard_manifest.log"}
: ${shard_manifest_pidfile:="/var/run/shard_manifest.pid"}

pidfile="${shard_manifest_pidfile}"
command="{{ manifest_bin_dir }}/shard-manifest"
command_args=""

start_precmd="shard_manifest_prestart"
start_cmd="shard_manifest_start"
stop_cmd="shard_manifest_stop"
status_cmd="shard_manifest_status"

shard_manifest_prestart()
{
    # Auto-export every variable rendered into the config file so the
    # export list can never drift from config.env.j2.
    if [ -f "${shard_manifest_config}" ]; then
        set -a
        . "${shard_manifest_config}"
        set +a
    fi
}

shard_manifest_start()
{
    shard_manifest_prestart
    /usr/sbin/daemon -f -p "${pidfile}" -u "${shard_manifest_user}" \
        ${command} >> "${shard_manifest_logfile}" 2>&1
    echo "shard_manifest started."
}

shard_manifest_stop()
{
    if [ -f "${pidfile}" ]; then
        kill -TERM $(cat "${pidfile}") && rm -f "${pidfile}"
        echo "shard_manifest stopped."
    else
        echo "shard_manifest is not running."
    fi
}

shard_manifest_status()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat "${pidfile}") 2>/dev/null; then
        echo "shard_manifest is running (pid $(cat ${pidfile}))."
    else
        echo "shard_manifest is not running."
        return 1
    fi
}

run_rc_command "$1"
